{
  "类": {
    "prefix": "类",
    "body": [
      "类 ${1:类名} {",
      "    ${2}",
      "}"
    ],
    "description": "定义中文 Java 类"
  },
  "主方法": {
    "prefix": "主方法",
    "body": [
      "公有 静态 无 main(字符串[] 参数) {",
      "    ${1}",
      "}"
    ],
    "description": "程序入口 main 方法"
  },
  "若": {
    "prefix": "若",
    "body": [
      "若 (${1:条件}) {",
      "    ${2}",
      "}"
    ],
    "description": "条件分支"
  },
  "否则": {
    "prefix": "否则",
    "body": [
      "否则 {",
      "    ${1}",
      "}"
    ],
    "description": "否则分支"
  },
  "否则若": {
    "prefix": "否则若",
    "body": [
      "} 否则若 (${1:条件}) {",
      "    ${2}",
      "}"
    ],
    "description": "接在若 / 否则若块后面的链式分支"
  },
  "重复": {
    "prefix": "重复",
    "body": [
      "重复 ${1:3} 次 {",
      "    ${2}",
      "}"
    ],
    "description": "固定次数循环（默认变量 序号）"
  },
  "入口": {
    "prefix": "入口",
    "body": [
      "入口 {",
      "    ${1}",
      "}"
    ],
    "description": "程序入口（main 方法的糖）"
  },
  "对于": {
    "prefix": "对于",
    "body": [
      "对于 (整数 ${1:i} = ${2:0}; ${1:i} < ${3:10}; ${1:i}++) {",
      "    ${4}",
      "}"
    ],
    "description": "计数 for 循环"
  },
  "当": {
    "prefix": "当",
    "body": [
      "当 (${1:条件}) {",
      "    ${2}",
      "}"
    ],
    "description": "while 循环"
  },
  "尝试": {
    "prefix": "尝试",
    "body": [
      "尝试 {",
      "    ${1}",
      "} 捕获 (${2:Exception} ${3:异常}) {",
      "    ${4}",
      "} 兜底 {",
      "    ${5}",
      "}"
    ],
    "description": "try / catch / finally"
  },
  "枚举": {
    "prefix": "枚举",
    "body": [
      "枚举 ${1:枚举名} {",
      "    ${2:常量一}, ${3:常量二}",
      "}"
    ],
    "description": "定义枚举"
  },
  "接口": {
    "prefix": "接口",
    "body": [
      "接口 ${1:接口名} {",
      "    ${2:String} ${3:方法名}();",
      "}"
    ],
    "description": "定义接口"
  },
  "打印": {
    "prefix": "打印",
    "body": [
      "打印行(${1:内容});"
    ],
    "description": "输出一行文本（System.out.println 的糖）"
  },
  "新建": {
    "prefix": "新建",
    "body": [
      "新建 ${1:类名}(${2})"
    ],
    "description": "创建对象"
  },
  "构造器": {
    "prefix": "构造器",
    "body": [
      "公有 ${1:类名}(${2}) {",
      "    ${3}",
      "}"
    ],
    "description": "公有构造器"
  },
  "导入": {
    "prefix": "导入",
    "body": [
      "导入 ${1:java.util.List};"
    ],
    "description": "导入包"
  },
  "记录": {
    "prefix": "记录",
    "body": [
      "记录 ${1:记录名}(${2:类型 字段}) {",
      "}"
    ],
    "description": "不可变数据类（record，JDK 16+）"
  },
  "密封类": {
    "prefix": "密封类",
    "body": [
      "密封 类 ${1:类名} 许可 ${2:子类一}, ${3:子类二} {",
      "    ${4}",
      "}"
    ],
    "description": "密封类：只允许许可的子类型继承（JDK 17+）"
  },
  "流": {
    "prefix": "流",
    "body": [
      "${1:名单}.流()",
      "    .过滤(${2:条件})",
      "    .收集(收集器.转清单());"
    ],
    "description": "Stream 链式处理（过滤 / 变换 / 去重 / 收集）"
  },
  "可选值": {
    "prefix": "可选值",
    "body": [
      "可选值<${1:对象}> ${2:结果} = 可选值.空();"
    ],
    "description": "Optional 容器，避免用 空 表示缺失"
  }
}
