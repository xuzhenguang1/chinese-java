{
  "类": {
    "prefix": "类",
    "body": [
      "类 ${1:类名} {",
      "    ${2}",
      "}"
    ],
    "description": "定义中文 Java 类"
  },
  "主方法": {
    "prefix": "主方法",
    "body": [
      "公有 静态 无 main(字符串[] 参数) {",
      "    ${1}",
      "}"
    ],
    "description": "程序入口 main 方法"
  },
  "若": {
    "prefix": "若",
    "body": [
      "若 (${1:条件}) {",
      "    ${2}",
      "}"
    ],
    "description": "条件分支"
  },
  "否则": {
    "prefix": "否则",
    "body": [
      "否则 {",
      "    ${1}",
      "}"
    ],
    "description": "否则分支"
  },
  "对于": {
    "prefix": "对于",
    "body": [
      "对于 (整数 ${1:i} = ${2:0}; ${1:i} < ${3:10}; ${1:i}++) {",
      "    ${4}",
      "}"
    ],
    "description": "计数 for 循环"
  },
  "当": {
    "prefix": "当",
    "body": [
      "当 (${1:条件}) {",
      "    ${2}",
      "}"
    ],
    "description": "while 循环"
  },
  "尝试": {
    "prefix": "尝试",
    "body": [
      "尝试 {",
      "    ${1}",
      "} 捕获 (${2:Exception} ${3:异常}) {",
      "    ${4}",
      "} 兜底 {",
      "    ${5}",
      "}"
    ],
    "description": "try / catch / finally"
  },
  "枚举": {
    "prefix": "枚举",
    "body": [
      "枚举 ${1:枚举名} {",
      "    ${2:常量一}, ${3:常量二}",
      "}"
    ],
    "description": "定义枚举"
  },
  "接口": {
    "prefix": "接口",
    "body": [
      "接口 ${1:接口名} {",
      "    ${2:String} ${3:方法名}();",
      "}"
    ],
    "description": "定义接口"
  },
  "打印": {
    "prefix": "打印",
    "body": [
      "打印行(${1:内容});"
    ],
    "description": "输出一行文本（System.out.println 的糖）"
  },
  "新建": {
    "prefix": "新建",
    "body": [
      "新建 ${1:类名}(${2})"
    ],
    "description": "创建对象"
  },
  "构造器": {
    "prefix": "构造器",
    "body": [
      "公有 ${1:类名}(${2}) {",
      "    ${3}",
      "}"
    ],
    "description": "公有构造器"
  },
  "导入": {
    "prefix": "导入",
    "body": [
      "导入 ${1:java.util.List};"
    ],
    "description": "导入包"
  }
}
