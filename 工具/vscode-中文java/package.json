{
  "name": "chinese-java",
  "displayName": "中文 Java",
  "description": "为中文关键字 Java 提供语法高亮、代码片段、补全与悬停，并注入到标准 Java 语法，不改变文件语言模式。",
  "version": "0.12.0",
  "publisher": "cjc",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:java",
    "onCommand:cjc.runFile"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.chinese-java.injection",
        "path": "./syntaxes/中文java.tmLanguage.json",
        "injectionSelector": "L:source.java -comment -string",
        "injectTo": [
          "source.java"
        ]
      }
    ],
    "snippets": [
      {
        "language": "java",
        "path": "./snippets/中文java.json"
      }
    ],
    "commands": [
      {
        "command": "cjc.runFile",
        "title": "中文 Java：运行当前文件"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cjc.runFile",
          "when": "editorLangId == java",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "中文 Java",
      "properties": {
        "cjc.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存 .java 文件时运行 cjc 检查：CJK001（空格粘连）与 CJK002（全角标点）显示为错误，CJK101–CJK103 新手提示显示为警告。"
        }
      }
    }
  }
}
